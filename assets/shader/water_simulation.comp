#version 430

layout(local_size_x = 8, local_size_y = 8) in;

// Water height field (read/write)
layout(std430, binding = 0) buffer HeightField
{
    float heights[];
};

// Velocity field (read/write)
layout(std430, binding = 1) buffer VelocityField
{
    float velocities[];
};

// Previous height field for wave simulation
layout(std430, binding = 2) buffer PrevHeightField
{
    float prevHeights[];
};

uniform float deltaTime;
uniform float time;
uniform int gridWidth;
uniform int gridHeight;
uniform float damping;        // Wave damping factor (0.98 - 0.999)
uniform float waveSpeed;      // Speed of wave propagation
uniform float waveStrength;   // Amplitude multiplier
uniform vec2 windDirection;   // Wind direction for external forces
uniform float windStrength;   // Wind force strength

// Hash function for procedural noise
float hash(vec2 p)
{
    p = fract(p * vec2(443.897, 441.423));
    p += dot(p, p + 19.19);
    return fract(p.x * p.y);
}

// Get 1D index from 2D coordinates
int getIndex(int x, int y)
{
    return y * gridWidth + x;
}

// Get height at grid position with boundary clamping
float getHeight(int x, int y)
{
    x = clamp(x, 0, gridWidth - 1);
    y = clamp(y, 0, gridHeight - 1);
    return heights[getIndex(x, y)];
}

void main()
{
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    
    if (id.x >= gridWidth || id.y >= gridHeight)
        return;
    
    int idx = getIndex(id.x, id.y);
    
    // Get current height and velocity
    float currentHeight = heights[idx];
    float currentVelocity = velocities[idx];
    
    // Wave equation: simulate 2D wave propagation
    // d²h/dt² = c² * ∇²h (2D wave equation)
    // where c is wave speed and ∇²h is the Laplacian
    
    // Calculate Laplacian (second spatial derivative)
    float left = getHeight(id.x - 1, id.y);
    float right = getHeight(id.x + 1, id.y);
    float up = getHeight(id.x, id.y - 1);
    float down = getHeight(id.x, id.y + 1);
    
    // 5-point stencil Laplacian
    float laplacian = (left + right + up + down - 4.0 * currentHeight);
    
    // Add diagonal neighbors for better wave propagation (9-point stencil)
    float upLeft = getHeight(id.x - 1, id.y - 1);
    float upRight = getHeight(id.x + 1, id.y - 1);
    float downLeft = getHeight(id.x - 1, id.y + 1);
    float downRight = getHeight(id.x + 1, id.y + 1);
    float diagonalContribution = (upLeft + upRight + downLeft + downRight - 4.0 * currentHeight) * 0.25;
    
    laplacian = laplacian * 0.5 + diagonalContribution * 0.5;
    
    // Wave equation acceleration
    float acceleration = waveSpeed * waveSpeed * laplacian;
    
    // Add procedural wave forcing (gentle ambient waves)
    vec2 worldPos = vec2(float(id.x) / float(gridWidth), float(id.y) / float(gridHeight));
    float wave1 = sin(worldPos.x * 6.28 * 2.0 + time * 0.8) * 0.0015;
    float wave2 = sin(worldPos.y * 6.28 * 1.5 - time * 0.6) * 0.0010;
    float wave3 = sin((worldPos.x + worldPos.y) * 6.28 * 1.0 + time * 1.0) * 0.0008;
    acceleration += (wave1 + wave2 + wave3) * waveStrength;
    
    // Add wind forcing
    float windPhase = time * 0.5 + dot(worldPos, windDirection);
    float windForce = sin(windPhase) * windStrength * 0.001;
    acceleration += windForce;
    
    // Update velocity using Verlet integration
    float newVelocity = currentVelocity + acceleration * deltaTime;
    
    // Apply damping to prevent energy buildup
    newVelocity *= damping;
    
    // Update height
    float newHeight = currentHeight + newVelocity * deltaTime;
    
    // Clamp height to prevent numerical instability
    newHeight = clamp(newHeight, -0.5, 0.5);
    
    // Store back to buffer
    velocities[idx] = newVelocity;
    prevHeights[idx] = currentHeight;
    heights[idx] = newHeight;
}
