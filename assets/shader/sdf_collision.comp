#version 430

layout(local_size_x = 64) in;

// Per-entity input: position + collision radius
struct CollisionEntity
{
    vec4 positionRadius; // xyz = world position, w = collision radius
};

// Per-entity output: collision response
struct CollisionResult
{
    vec4 pushVector;    // xyz = push direction * penetration magnitude, w = penetration depth
    vec4 surfaceNormal; // xyz = surface normal at contact point, w = 1.0 if colliding, 0.0 otherwise
};

layout(std430, binding = 0) readonly buffer EntityBuffer
{
    CollisionEntity entities[];
};

layout(std430, binding = 1) writeonly buffer ResultBuffer
{
    CollisionResult results[];
};

uniform sampler3D sdfTexture;

uniform vec3  gridOrigin;    // World-space position of voxel (0,0,0) corner
uniform float voxelSize;     // World-space size of each voxel
uniform ivec3 gridSize;      // Number of voxels per axis
uniform uint  entityCount;

// Convert world position to normalized [0,1] texture coordinates for sampling
vec3 worldToUV(vec3 worldPos)
{
    vec3 gridExtent = vec3(gridSize) * voxelSize;
    return (worldPos - gridOrigin) / gridExtent;
}

// Sample the signed distance field at a world position using trilinear interpolation
float sampleSDF(vec3 worldPos)
{
    vec3 uv = worldToUV(worldPos);

    // If the query point is outside the SDF volume, return a large positive distance
    // so that entities outside the grid are never considered colliding with geometry.
    if (any(lessThan(uv, vec3(0.0))) || any(greaterThan(uv, vec3(1.0))))
        return 1.0e4;

    return texture(sdfTexture, uv).r;
}

// Compute the gradient of the SDF (points from inside toward outside = surface normal)
// Uses central differences with a half-voxel step for smooth results.
vec3 sdfGradient(vec3 worldPos)
{
    float eps = voxelSize * 0.5;

    float dx = sampleSDF(worldPos + vec3(eps, 0.0, 0.0))
             - sampleSDF(worldPos - vec3(eps, 0.0, 0.0));
    float dy = sampleSDF(worldPos + vec3(0.0, eps, 0.0))
             - sampleSDF(worldPos - vec3(0.0, eps, 0.0));
    float dz = sampleSDF(worldPos + vec3(0.0, 0.0, eps))
             - sampleSDF(worldPos - vec3(0.0, 0.0, eps));

    vec3 g = vec3(dx, dy, dz);
    float len = length(g);

    // Avoid division by zero; fallback to "push up" if gradient is degenerate
    if (len < 1.0e-8)
        return vec3(0.0, 1.0, 0.0);

    return g / len;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= entityCount)
        return;

    vec3  pos    = entities[id].positionRadius.xyz;
    float radius = entities[id].positionRadius.w;

    // Sample SDF at entity center
    float dist = sampleSDF(pos);

    CollisionResult result;

    float absDist = abs(dist);

    if (absDist < radius)
    {
        // Entity's bounding sphere overlaps geometry
        vec3 normal = sdfGradient(pos);
        if (dist < 0.0)
            normal = -normal;

        float penetration = radius - absDist;

        result.pushVector    = vec4(normal * penetration, penetration);
        result.surfaceNormal = vec4(normal, 1.0);
    }
    else
    {
        // No collision
        result.pushVector    = vec4(0.0, 0.0, 0.0, 0.0);
        result.surfaceNormal = vec4(0.0, 0.0, 0.0, 0.0);
    }

    results[id] = result;
}