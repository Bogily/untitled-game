#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer AllInstances
{
    vec4 instances[]; // x,y,z,scale
} allIn;

struct VisibleEntry {
    vec4 instance; // x,y,z,scale
    vec4 wind;     // wind.x, wind.z, unused, unused
};

layout(std430, binding = 1) buffer VisibleOut
{
    uint counter;
    // padding to 16 bytes for std430 alignment
    uint pad0; uint pad1; uint pad2;
    VisibleEntry entries[];
} outVis;

uniform vec4 frustumPlanes[6]; // (xyz = normal, w = distance)
uniform float radius;
uniform uint instanceCount;
uniform float time;
uniform vec2 windDirection;
uniform float windStrength;
uniform float windSpeed;
uniform float radiusMultiplier; // >1.0 retains instances longer

// Improved frustum test - early exit for better performance
bool isInFrustum(vec3 p, float r)
{
    float scaledRadius = r * radiusMultiplier;
    
    // Test far plane first (most likely to cull grass behind camera)
    if (dot(frustumPlanes[5].xyz, p) + frustumPlanes[5].w < -scaledRadius)
        return false;
    
    // Skip near plane (index 4) to prevent popping under camera
    
    // Test left plane
    if (dot(frustumPlanes[0].xyz, p) + frustumPlanes[0].w < -scaledRadius)
        return false;
    
    // Test right plane
    if (dot(frustumPlanes[1].xyz, p) + frustumPlanes[1].w < -scaledRadius)
        return false;
    
    // Test bottom plane
    if (dot(frustumPlanes[2].xyz, p) + frustumPlanes[2].w < -scaledRadius)
        return false;
    
    // Test top plane
    if (dot(frustumPlanes[3].xyz, p) + frustumPlanes[3].w < -scaledRadius)
        return false;
    
    return true;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= instanceCount) return;

    vec4 inst = allIn.instances[id];
    vec3 pos = vec3(inst.x, inst.y, inst.z);

    if (isInFrustum(pos, radius))
    {
        // Compute wind for this instance
        // Use multiple octaves for more natural wind
        float windWave = sin(time * windSpeed + pos.x * 0.5 + pos.z * 0.3) * 0.5 + 0.5;
        windWave += sin(time * windSpeed * 1.3 + pos.x * 0.3 + pos.z * 0.5) * 0.3;
        windWave += sin(time * windSpeed * 0.7 + pos.x * 0.7 + pos.z * 0.2) * 0.2;
        windWave = clamp(windWave, 0.0, 1.0);
        
        vec2 windOffset = windDirection * windWave * windStrength;

        uint idx = atomicAdd(outVis.counter, 1u);
        outVis.entries[idx].instance = inst;
        outVis.entries[idx].wind = vec4(windOffset.x, windOffset.y, 0.0, 0.0);
    }
}
