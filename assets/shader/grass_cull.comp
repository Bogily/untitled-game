#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer AllInstances
{
    vec4 instances[]; // x,y,z,scale
} allIn;

layout(std430, binding = 1) buffer VisibleOut
{
    uint counter;
    vec4 instances[]; // compacted visible instances
} outVis;

uniform vec4 frustumPlanes[6]; // (xyz = normal, w = distance)
uniform float radius;
uniform uint instanceCount;

bool isInFrustum(vec3 p)
{
    for (int i = 0; i < 6; ++i)
    {
        float d = dot(frustumPlanes[i].xyz, p) + frustumPlanes[i].w;
        if (d < -radius) return false;
    }
    return true;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= instanceCount) return;

    vec4 inst = allIn.instances[id];
    vec3 pos = vec3(inst.x, inst.y, inst.z);

    if (isInFrustum(pos))
    {
        uint idx = atomicAdd(outVis.counter, 1u);
        outVis.instances[idx] = inst;
    }
}
