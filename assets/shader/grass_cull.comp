#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer AllInstances
{
    vec4 instances[]; // x,y,z,scale
} allIn;

struct VisibleEntry {
    vec4 instance; // x,y,z,scale
    vec4 wind;     // wind.x, wind.z, unused, unused
};

layout(std430, binding = 1) buffer VisibleOut
{
    uint counter;
    // padding to 16 bytes for std430 alignment
    uint pad0; uint pad1; uint pad2;
    VisibleEntry entries[];
} outVis;

uniform vec4 frustumPlanes[6]; // (xyz = normal, w = distance)
uniform float radius;
uniform uint instanceCount;
uniform float time;
uniform vec2 windDirection;
uniform float windStrength;
uniform float windSpeed;
uniform float radiusMultiplier; // >1.0 retains instances longer

bool isInFrustum(vec3 p)
{
    for (int i = 0; i < 6; ++i)
    {
        // Skip near plane to prevent popping under camera
        if (i == 4) continue;
        float d = dot(frustumPlanes[i].xyz, p) + frustumPlanes[i].w;
        if (d < -(radius * radiusMultiplier)) return false;
    }
    return true;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= instanceCount) return;

    vec4 inst = allIn.instances[id];
    vec3 pos = vec3(inst.x, inst.y, inst.z);

    if (isInFrustum(pos))
    {
        // compute wind for this instance
        float heightFactor = 1.0; // per-instance height factor applied in vertex shader
        float windWave = sin(time * windSpeed + pos.x * 0.5 + pos.z * 0.3) * 0.5 + 0.5;
        windWave += sin(time * windSpeed * 1.3 + pos.x * 0.3 + pos.z * 0.5) * 0.3;
        vec2 windOffset = vec2(windDirection.x * windWave * windStrength, windDirection.y * windWave * windStrength);

        uint idx = atomicAdd(outVis.counter, 1u);
        outVis.entries[idx].instance = inst;
        outVis.entries[idx].wind = vec4(windOffset.x, windOffset.y, 0.0, 0.0);
    }
}
