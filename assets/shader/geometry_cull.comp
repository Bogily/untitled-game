#version 430

layout(local_size_x = 256) in;

struct ModelInstance
{
    vec4 positionScale;   // xyz = position, w = uniform scale
    vec4 rotation;        // xyz = rotation (degrees), w = padding
    vec4 boundsMin;       // AABB min in local space
    vec4 boundsMax;       // AABB max in local space
    uint modelID;         // Which model to draw
    uint pad0, pad1, pad2; // Padding for alignment
};

layout(std430, binding = 0) readonly buffer AllInstances
{
    ModelInstance instances[];
} allIn;

layout(std430, binding = 1) buffer VisibleOut
{
    uint counter;
    uint pad0, pad1, pad2; // Padding to 16 bytes
    uint visibleIndices[]; // Indices into allIn.instances
} outVis;

uniform vec4 frustumPlanes[6]; // (xyz = normal, w = distance)
uniform uint instanceCount;
uniform float radiusMultiplier; // >1.0 retains objects longer

const float DEG2RAD = 0.0174532925;

// Create rotation matrix from Euler angles (degrees)
mat3 rotationMatrix(vec3 rotation)
{
    vec3 rot = rotation * DEG2RAD;
    float cx = cos(rot.x);
    float sx = sin(rot.x);
    float cy = cos(rot.y);
    float sy = sin(rot.y);
    float cz = cos(rot.z);
    float sz = sin(rot.z);
    
    // ZYX order (raylib default)
    mat3 matX = mat3(1.0, 0.0, 0.0,
                     0.0, cx, -sx,
                     0.0, sx, cx);
    
    mat3 matY = mat3(cy, 0.0, sy,
                     0.0, 1.0, 0.0,
                     -sy, 0.0, cy);
    
    mat3 matZ = mat3(cz, -sz, 0.0,
                     sz, cz, 0.0,
                     0.0, 0.0, 1.0);
    
    return matZ * matY * matX;
}

// Conservative test: use bounding sphere of AABB
// Culls only when the entire sphere is outside a plane
bool isAABBInFrustum(vec3 center, vec3 extents)
{
    float radius = length(extents) * radiusMultiplier; // conservative sphere
    for (int i = 0; i < 6; ++i)
    {
        // Skip near plane to avoid popping when camera is very close
        if (i == 4) continue;

        vec3 normal = frustumPlanes[i].xyz;
        float dist = frustumPlanes[i].w;
        float planeDist = dot(normal, center) + dist;
        if (planeDist < -radius)
            return false; // fully outside this plane
    }
    return true;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= instanceCount) return;

    ModelInstance inst = allIn.instances[id];
    
    // Calculate world-space AABB
    vec3 worldPos = inst.positionScale.xyz;
    vec3 rotation = inst.rotation.xyz;
    float scale = inst.positionScale.w;
    
    vec3 localMin = inst.boundsMin.xyz * scale;
    vec3 localMax = inst.boundsMax.xyz * scale;
    
    vec3 center, extents;
    
    // If object has rotation, calculate expanded AABB
    if (rotation.x != 0.0 || rotation.y != 0.0 || rotation.z != 0.0)
    {
        mat3 rotMat = rotationMatrix(rotation);
        
        // Transform all 8 corners of the bounding box
        vec3 corners[8];
        corners[0] = vec3(localMin.x, localMin.y, localMin.z);
        corners[1] = vec3(localMax.x, localMin.y, localMin.z);
        corners[2] = vec3(localMin.x, localMax.y, localMin.z);
        corners[3] = vec3(localMax.x, localMax.y, localMin.z);
        corners[4] = vec3(localMin.x, localMin.y, localMax.z);
        corners[5] = vec3(localMax.x, localMin.y, localMax.z);
        corners[6] = vec3(localMin.x, localMax.y, localMax.z);
        corners[7] = vec3(localMax.x, localMax.y, localMax.z);
        
        vec3 transformedMin = vec3(1e10);
        vec3 transformedMax = vec3(-1e10);
        
        for (int i = 0; i < 8; i++)
        {
            vec3 transformed = rotMat * corners[i];
            transformedMin = min(transformedMin, transformed);
            transformedMax = max(transformedMax, transformed);
        }
        
        center = worldPos + (transformedMin + transformedMax) * 0.5;
        extents = (transformedMax - transformedMin) * 0.5;
    }
    else
    {
        // No rotation - simple transform
        center = worldPos + (localMin + localMax) * 0.5;
        extents = (localMax - localMin) * 0.5;
    }
    
    if (isAABBInFrustum(center, extents))
    {
        uint idx = atomicAdd(outVis.counter, 1u);
        outVis.visibleIndices[idx] = id;
    }
}
